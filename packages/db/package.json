{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check-types": "tsx scripts/sync-schema-index.ts && tsc --noEmit",
    "db:generate": "tsx scripts/sync-schema-index.ts && drizzle-kit generate",
    "schema:sync": "tsx scripts/sync-schema-index.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@repo/shared": "*",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.1",
    "tsx": "^4.20.3",
    "typescript": "5.9.2"
  }
}
