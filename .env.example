DATABASE_URL=postgresql://ballerz:ballerz@localhost:5432/ballerz

# NextAuth (required for login and realtime tokens)
AUTH_SECRET=change-me-to-a-random-secret
# Public root URL of the web app (e.g. https://ballerz.example.com in production)
AUTH_URL=http://localhost:3000

# Realtime WebSocket server
# REALTIME_URL is called server-to-server (web -> realtime). Under
# compose.yaml this resolves via Docker DNS, so leave it as http://realtime:3001
# in production - do not point it at a public domain.
REALTIME_URL=http://localhost:3001
REALTIME_PORT=3001
REALTIME_PUBLISH_SECRET=change-me-to-a-random-secret
# NEXT_PUBLIC_REALTIME_WS_URL is opened by the BROWSER and gets baked into the
# client bundle at build time. In production this must be the public wss://
# domain you assign to the `realtime` service in Dokploy, e.g.
# wss://realtime.example.com/ws
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:3001/ws

# Optional seed overrides (defaults shown)
# SEED_USER_EMAIL=seed@ballerz.local
# SEED_USER_PASSWORD=password
# SEED_LEAGUE_NAME=Pickup League
